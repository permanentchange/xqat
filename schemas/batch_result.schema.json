{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_fingerprint",
    "mode",
    "started_at",
    "completed_at",
    "complete",
    "tasks",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "plan_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "bootstrap",
        "update"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "complete": {
      "type": "boolean"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partition_id",
          "identity",
          "status",
          "path",
          "error_code",
          "error_category",
          "attempts",
          "row_count",
          "http_status",
          "provider_code",
          "started_at",
          "completed_at",
          "elapsed_seconds"
        ],
        "properties": {
          "partition_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset_id",
              "api_name",
              "fields",
              "parameters",
              "start",
              "end"
            ],
            "properties": {
              "dataset_id": {
                "type": "string"
              },
              "api_name": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "parameters": {
                "type": "object"
              },
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "status": {
            "enum": [
              "succeeded",
              "skipped",
              "failed",
              "not_executed",
              "interrupted"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "row_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "provider_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers"
      ],
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "calls_per_minute": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "api_limits": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
