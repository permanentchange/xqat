{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xqatexp.local/schemas/target_portfolio-2.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_id",
    "strategy_version",
    "decision_date",
    "effective_from",
    "positions",
    "transition_records",
    "cash_weight",
    "explanations"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "strategy_id": { "type": "string", "minLength": 1 },
    "strategy_version": { "type": "string", "minLength": 1 },
    "decision_date": { "type": "string", "format": "date" },
    "effective_from": { "type": "string", "format": "date" },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "security_id",
          "asset_type",
          "target_weight",
          "transition",
          "explanation_codes",
          "planning_priority"
        ],
        "properties": {
          "security_id": { "type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ)$" },
          "asset_type": { "enum": ["A_SHARE", "CSI300_ETF"] },
          "target_weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "transition": {
            "type": ["string", "null"],
            "enum": ["NEW", "RETAIN", "INCREASE", "DECREASE", "INITIAL", null]
          },
          "explanation_codes": { "type": "array", "items": { "type": "string" } },
          "planning_priority": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "transition_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "security_id",
          "previous_weight",
          "current_weight",
          "transition",
          "explanation_codes"
        ],
        "properties": {
          "security_id": { "type": "string" },
          "previous_weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "current_weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "transition": { "enum": ["NEW", "RETAIN", "INCREASE", "DECREASE", "EXIT", "INITIAL"] },
          "explanation_codes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "cash_weight": { "type": "number", "minimum": 0, "maximum": 1 },
    "explanations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "values"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "values": { "type": "object" }
        }
      }
    }
  }
}
