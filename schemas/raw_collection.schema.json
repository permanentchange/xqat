{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "complete",
    "expected_partitions",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "complete": {
      "type": "boolean"
    },
    "expected_partitions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partition_id",
          "generation",
          "path",
          "identity",
          "manifest_sha256"
        ],
        "properties": {
          "partition_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset_id",
              "api_name",
              "fields",
              "parameters",
              "start",
              "end"
            ],
            "properties": {
              "dataset_id": {
                "type": "string"
              },
              "api_name": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "parameters": {
                "type": "object"
              },
              "start": {
                "type": "string",
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
