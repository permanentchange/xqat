{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "formula_version", "date_start", "date_end", "valuation_points", "return_intervals", "initial_nav", "final_nav", "cumulative_return", "annualized_return", "annualized_volatility", "max_drawdown", "max_drawdown_peak_date", "max_drawdown_trough_date", "max_drawdown_recovery_date", "sharpe", "calmar", "one_way_turnover", "two_way_adjustment_turnover", "total_commission", "total_transfer_fee", "total_stamp_duty", "total_slippage_cost", "stock_return_contribution", "etf_return_contribution", "cash_cost_contribution", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "formula_version": { "type": "string", "minLength": 1 },
    "date_start": { "type": "string", "format": "date" },
    "date_end": { "type": "string", "format": "date" },
    "valuation_points": { "type": "integer", "minimum": 1 },
    "return_intervals": { "type": "integer", "minimum": 0 },
    "initial_nav": { "type": "number", "exclusiveMinimum": 0 },
    "final_nav": { "type": "number", "minimum": 0 },
    "cumulative_return": { "type": ["number", "null"] },
    "annualized_return": { "type": ["number", "null"] },
    "annualized_volatility": { "type": ["number", "null"], "minimum": 0 },
    "max_drawdown": { "type": ["number", "null"], "maximum": 0 },
    "max_drawdown_peak_date": { "type": ["string", "null"], "format": "date" },
    "max_drawdown_trough_date": { "type": ["string", "null"], "format": "date" },
    "max_drawdown_recovery_date": { "type": ["string", "null"], "format": "date" },
    "sharpe": { "type": ["number", "null"] },
    "calmar": { "type": ["number", "null"] },
    "one_way_turnover": { "type": "number", "minimum": 0 },
    "two_way_adjustment_turnover": { "type": "number", "minimum": 0 },
    "total_commission": { "type": "number", "minimum": 0 },
    "total_transfer_fee": { "type": "number", "minimum": 0 },
    "total_stamp_duty": { "type": "number", "minimum": 0 },
    "total_slippage_cost": { "type": "number" },
    "stock_return_contribution": { "type": ["number", "null"] },
    "etf_return_contribution": { "type": ["number", "null"] },
    "cash_cost_contribution": { "type": ["number", "null"] },
    "limitations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
