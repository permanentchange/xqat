{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xqatexp.local/schemas/artifact_manifest-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "run",
    "inputs",
    "date_scope",
    "files",
    "issues",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": {
      "enum": [
        "RAW_DATA",
        "RESEARCH_DATA",
        "BACKTEST_RESULT",
        "DAILY_TARGET_RESULT",
        "DAILY_ADVICE_RESULT",
        "FAILURE_DIAGNOSTIC"
      ]
    },
    "artifact_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "run": { "type": ["object", "null"] },
    "inputs": { "type": "array", "items": { "type": "object" } },
    "date_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": ["string", "null"], "format": "date" },
        "end": { "type": ["string", "null"], "format": "date" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "media_type",
          "size_bytes",
          "sha256",
          "row_count",
          "schema_id",
          "schema_version"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "row_count": { "type": ["integer", "null"], "minimum": 0 },
          "schema_id": { "type": ["string", "null"] },
          "schema_version": { "type": ["string", "null"] }
        }
      }
    },
    "issues": { "type": "array", "items": { "type": "object" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}

